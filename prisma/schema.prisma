// fz-mart — Prisma schema
//
// Phase-0 scope: model only what Phase 1 (the storefront vertical slice) needs,
// plus the generic Setting model that many later features depend on.
// Integration models (CourierShipment, SmsLog, MailLog, FraudCheckResult,
// BlockedIp) are added in their own phases — premature schema is rework.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

// How the products in a category branch are sold. Mirrors the three cards in
// the product form's "How is it sold?" step (form/types.ts SellingType), which
// is the lower-case client-side spelling of this same choice.
//
//   SINGLE  one price, one stock, gallery photos (a charger, a toy, groceries)
//   COLORS  one row per colour, each with its own photo (a bag, a watch)
//   SIZES   sizes, optionally crossed with colours (a dress, a panjabi)
enum SellingType {
  SINGLE
  COLORS
  SIZES
}

// Self-referencing category tree of arbitrary depth. A root has parentId=null;
// any node can hold both children (sub-categories) AND products, so admins can
// place a product at whatever level makes sense. The old two-model
// Category/Subcategory split was collapsed into this single tree — see
// prisma/migrations/*_add_category_tree. Prisma can't `include` unbounded
// depth, so the app fetches all rows flat and assembles the tree in JS
// (src/server/categories/tree.ts).
model Category {
  id                 Int          @id @default(autoincrement())
  // null = root; otherwise the parent node. Restrict delete: a node with
  // children can't be removed until they're moved/deleted (enforced in
  // server/categories/admin.ts with a friendly error).
  parentId           Int?
  name               String
  slug               String       @unique
  // Optional hero image + short blurb shown on the storefront category pages.
  imageUrl           String?
  // Alternative to imageUrl: a key from CATEGORY_ICONS (lib/category-icons.tsx)
  // drawn as an inline SVG. A category shows its image when imageUrl is set,
  // otherwise this icon, otherwise a letter tile — see CategoryVisual. Both may
  // be stored; imageUrl wins, so switching back to the icon needs no re-upload.
  iconKey            String?
  description        String?      @db.Text
  sortOrder          Int          @default(0)
  isActive           Boolean      @default(true)
  // Optional SEO overrides (Phase 2). When blank the storefront falls back to
  // a sensible default derived from the name — see lib/seo.ts.
  metaTitle          String?
  metaDescription    String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  // Default size guide for everything in this branch of the tree. Resolution
  // walks UPWARD: a product with no guide of its own uses the nearest ancestor
  // category that has one, so setting "Apparel S–XXL" on "Men's & Boy's
  // Fashion" covers every shirt below it. Null = inherit / none.
  sizeGuideId        Int?
  // How products in this branch are sold. Resolution walks UPWARD exactly like
  // sizeGuideId above: null = inherit the nearest ancestor's, so setting SIZES
  // on "Men's & Boy's Fashion" covers every shirt category below it. Roots must
  // set one — there is nothing above them to inherit from — which the category
  // form enforces; the column stays nullable so children can mean "inherit".
  //
  // The product form opens locked in the resolved type and the admin must
  // confirm to deviate (a ring in a COLORS "Jewelry", say). It is a default and
  // an override prompt, never a constraint: a saved product's own shape always
  // wins on edit, so re-typing a category can never rewrite existing products.
  defaultSellingType SellingType?
  parent             Category?    @relation("CatTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children           Category[]   @relation("CatTree")
  products           Product[]
  coupons            Coupon[]
  sizeGuide          SizeGuide?   @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)

  @@index([sizeGuideId])
  @@index([parentId, isActive, sortOrder])
  // Ordering siblings within a parent (sortOrder, then name) — the isActive
  // column sits between parentId and sortOrder in the index above, so that one
  // can't serve this ordering.
  @@index([parentId, sortOrder])
}

model Product {
  id                 Int                       @id @default(autoincrement())
  // Any node in the Category tree — a root, a mid-level, or a leaf.
  categoryId         Int
  name               String
  slug               String                    @unique
  description        String?                   @db.Text
  // price and discountPrice are stored in the smallest currency unit (paisa)
  // as integers to avoid floating-point rounding on money.
  price              Int
  discountPrice      Int?
  // Current sourcing/purchase cost per unit (paisa) — what it costs the shop to
  // stock one unit. Feeds COGS: it is SNAPSHOTTED onto OrderItem at checkout so
  // later supplier-price changes never rewrite historical margins.
  purchaseCost       Int                       @default(0)
  // ON HAND — units physically in the warehouse. Since Phase D this is NOT what
  // the storefront sells against: an order reserves units without removing them
  // from the shelf, and they leave `stock` only when the parcel actually ships.
  stock              Int                       @default(0)
  // RESERVED — units promised to orders that have neither shipped nor died.
  // Incremented at checkout, decremented when the order ships (the units then
  // leave `stock` too) or when it is cancelled (they simply become free again).
  //
  // AVAILABLE = stock − reserved, and that is the number the storefront must
  // sell against. Never negative: every path that raises it is a conditional
  // update guarded on sufficient availability.
  reserved           Int                       @default(0)
  // Low-stock alert threshold (Phase 5). When 0 < stock <= this, the product
  // surfaces in the admin low-stock alert + daily digest. 0 disables it.
  lowStockThreshold  Int                       @default(0)
  // Whether the "In stock (N available)" count is shown on the storefront for a
  // simple (variant-less) product. Availability (sold-out disabling) is
  // unaffected — this only hides the number. Mirrors ProductVariant.showStock.
  showStock          Boolean                   @default(true)
  // Optional storefront colour for this product's price text, as a #rrggbb hex
  // string. Null = use the theme default (near-black). Purely presentational:
  // it never affects the amount charged. A variant's own priceColor wins over
  // this one when a variant is selected.
  priceColor         String?
  // ── Sizing ──
  // Which size guide drives this product's size chips, their label ("Bust
  // Size") and the Size Chart link. Null = inherit the category's (see
  // Category.sizeGuideId); the two fields below override the resolved guide
  // for a one-off product that doesn't deserve a guide of its own.
  sizeGuideId        Int?
  sizeLabel          String?
  sizeChart          String?                   @db.Text
  // ── Inventory ──
  // Root of the generated variant SKUs ("SAR" → "SAR-PUR-32"). Null = this
  // product's variants carry whatever SKUs were typed, or none at all.
  baseSku            String?
  isFeatured         Boolean                   @default(false)
  status             ProductStatus             @default(ACTIVE)
  promoBadge         String?
  // Gradient offer strip on the product page, under the price ("Buy 1 Get 1
  // Free", "Eid Special — extra ৳100 off"). Admin-written free text, shown ONLY
  // when the product is actually discounted, so a stale banner can't outlive the
  // offer it advertises. Null/blank = no strip.
  offerText          String?
  // Optional SEO overrides (Phase 2); blank → default from name/description.
  metaTitle          String?
  metaDescription    String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  // Restrict: a category can't be deleted while products reference it (the
  // admin delete flow blocks this up front — see getCategoryDeleteImpact).
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  orderItems         OrderItem[]
  flashSales         FlashSaleProduct[]
  colors             ProductColor[]
  specifications     ProductSpecification[]
  features           ProductFeature[]
  accordionSections  ProductAccordionSection[]
  reviews            ProductReview[]
  variants           ProductVariant[]
  wishlistItems      WishlistItem[]
  stockNotifications StockNotification[]
  stockAdjustments   StockAdjustment[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  coupons            Coupon[]
  cartItems          CustomerCartItem[]
  cartEvents         CartEvent[]
  sizeGuide          SizeGuide?                @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)

  @@index([sizeGuideId])
  // Looking a product up by the root of its SKUs.
  @@index([baseSku])
  @@index([categoryId, status])
  @@index([isFeatured, status])
  // Full-text search over name + description. The default parser is
  // whitespace/punctuation based, which handles space-separated Bangla words;
  // querying is via MATCH … AGAINST in server/products/search.ts.
  //
  // TiDB only supports single-column FULLTEXT indexes, so name and description
  // are indexed separately and the search queries MATCH each column on its own
  // (summing the two AGAINST scores for relevance).
  @@fulltext([name])
  @@fulltext([description])
}

// Purchasable option of a product — one cell of the (color × size) matrix.
// Either dimension may be null:
//   • Oil:     size="1 Litre", colorName=null         (size-only)
//   • T-shirt: size="M", colorName="Navy Blue"        (color + size combo)
//   • Color-only good: size=null, colorName="Red"
// When a product has any variants the customer MUST pick one; that variant's
// own price and stock are authoritative (product price becomes a "from" only).
// colorName links to a ProductColor by name, which supplies the swatch image.
// A reusable set of sizes — the chips a shopper picks from, what to call them,
// and the chart behind the "Size Chart" link. Attached to a Category (inherited
// down the tree) and overridable per Product, so "Blouse / bust sizes" is typed
// once and every blouse gets 32…52 in the right order with the right label.
//
// The guide is a TEMPLATE, not a stock record: a product's actual sellable
// combinations still live in ProductVariant. Deleting a guide only unsets the
// pointers (SetNull) — no product loses its variants.
model SizeGuide {
  id         Int              @id @default(autoincrement())
  // Admin-facing name, e.g. "Blouse / bust sizes".
  name       String
  // Shopper-facing label: "Bust Size" renders as "Select Bust Size:".
  // Null = the generic "Size".
  sizeLabel  String?
  // Markdown table shown behind the storefront's "Size Chart" link, rendered
  // by lib/markdown.ts like every other admin-authored block.
  chart      String?          @db.Text
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  values     SizeGuideValue[]
  categories Category[]
  products   Product[]
}

// One chip in a guide. Ordering is explicit because size order is never
// alphabetical or numeric — S/M/L/XL, and bust runs 38, 40, 42 after skipping
// the odd numbers. Unique per guide so a duplicate chip can't be created.
model SizeGuideValue {
  id        Int       @id @default(autoincrement())
  guideId   Int
  value     String // "32", "M", "XXL"
  sortOrder Int       @default(0)
  guide     SizeGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, value])
  @@index([guideId, sortOrder])
}

model ProductVariant {
  id                 Int                 @id @default(autoincrement())
  productId          Int
  size               String? // "500 ml", "M", "XL"
  colorName          String? // matches a ProductColor.name for the swatch/image
  // Stock-keeping unit for this exact option, usually generated from the
  // product's baseSku ("SAR-PUR-32"). Unique shop-wide when set; null for the
  // products and rows that don't use SKUs. NOTE: variants are wiped and
  // recreated on every product save (see server/products/admin.ts), so the
  // admin form must round-trip this value — it is not regenerated per save.
  sku                String?             @unique
  price              Int // paisa — authoritative "regular" price for this option
  // Optional sale price (paisa). When set (and below price) it's the amount
  // actually charged; price shows struck-through. Null = no discount.
  discountPrice      Int?
  // Per-variant sourcing cost (paisa). 0 = "inherit the product's purchaseCost";
  // checkout falls back to Product.purchaseCost when this is 0.
  purchaseCost       Int                 @default(0)
  // On hand / reserved for this exact option — same meaning as on Product, and
  // the authoritative pair for a sized product. AVAILABLE = stock − reserved.
  stock              Int                 @default(0)
  reserved           Int                 @default(0)
  // Whether the "X in stock" count is shown on the storefront for this variant.
  // Availability (sold-out disabling) is unaffected — this only hides the number.
  showStock          Boolean             @default(true)
  // Per-variant override for the storefront price colour (#rrggbb). Null =
  // inherit Product.priceColor, which itself falls back to the theme default.
  priceColor         String?
  // Photo for this specific option, uploaded from the admin product form. Held
  // per-row rather than on ProductColor so two rows sharing a colour (Navy/M,
  // Navy/L) can differ and a size-only row can have one. Null = no photo.
  imageUrl           String?
  sortOrder          Int                 @default(0)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  // SetNull on the far side: variants are wiped and recreated on every product
  // save, so a movement outlives the variant row it named. It keeps productId,
  // so per-product history stays complete either way.
  stockMovements     StockMovement[]
  // Same SetNull reasoning: a PO line outlives the variant row it named.
  purchaseOrderLines PurchaseOrderLine[]

  @@index([productId, sortOrder])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model ProductImage {
  id           Int     @id @default(autoincrement())
  productId    Int
  url          String
  isPrimary    Boolean @default(false)
  sortOrder    Int     @default(0)
  // Which variant this photo shows, as a label snapshot ("Navy / M") rather
  // than a variantId FK — variants are wiped & recreated on every product save
  // (see updateProduct), so an FK would break on each edit. Null = whole-product
  // photo. Matches the label derived from ProductVariant colorName/size.
  variantLabel String?
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductColor {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  hexCode   String
  imageUrl  String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductSpecification {
  id        Int     @id @default(autoincrement())
  productId Int
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductFeature {
  id        Int     @id @default(autoincrement())
  productId Int
  text      String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// One collapsible panel in the product page's "Features & Specs" accordion,
// authored in the admin's Accordion Builder. Ordered by sortOrder; when a
// product has any of these they REPLACE the flat Markdown description in that
// tab (see ProductTabs). Body is Markdown, rendered with the same pipeline as
// Product.description, so tables/bullets/emoji all work.
model ProductAccordionSection {
  id        Int     @id @default(autoincrement())
  productId Int
  title     String
  // Leading emoji shown before the title on the storefront ("⚙️"). Optional —
  // blank renders the title alone.
  icon      String?
  content   String  @db.Text
  // Whether this panel starts expanded on first paint.
  isOpen    Boolean @default(false)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// One review per customer per product — enforced by the unique constraint
// below, so re-submitting overwrites rather than duplicates.
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model ProductReview {
  id         Int          @id @default(autoincrement())
  productId  Int
  customerId String
  rating     Int
  comment    String       @db.Text
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status, createdAt])
}

model Banner {
  id        Int        @id @default(autoincrement())
  imageUrl  String
  link      String?
  // Which hero area this image fills. MAIN is the big left banner (supports
  // several images as a carousel); the RIGHT_* slots are single cards.
  slot      BannerSlot @default(MAIN)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@index([slot, isActive, sortOrder])
}

enum BannerSlot {
  MAIN
  RIGHT_TOP
  RIGHT_BOTTOM
}

// A scheduled campaign with a curated product list. "Active" on the
// storefront means isActive=true AND now is within [startsAt, endsAt] —
// the boolean lets an admin pause a campaign without losing its dates.
model FlashSale {
  id        Int                @id @default(autoincrement())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  products  FlashSaleProduct[]

  @@index([isActive, startsAt, endsAt])
}

model FlashSaleProduct {
  id          Int       @id @default(autoincrement())
  flashSaleId Int
  productId   Int
  // Optional override price (paisa) for the duration of the sale, distinct
  // from the product's own discountPrice so the same product can carry a
  // deeper, time-boxed cut without permanently changing its catalog price.
  salePrice   Int?
  sortOrder   Int       @default(0)
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
  @@index([flashSaleId, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Customers (passwordless — magic link or Google sign-in, no password)
// ─────────────────────────────────────────────────────────────

enum AuthProvider {
  GOOGLE
  EMAIL
}

model Customer {
  // Custom, human-readable id of the form `fz-XXXXXX` (see lib/customer-id.ts).
  // Generated in application code, so no @default here.
  id           String            @id
  // Sign-in identity (magic link / Google). NEVER editable from the profile —
  // changing it would lock the customer out. `contactEmail` exists for the
  // "reach me here instead" case.
  email        String            @unique
  name         String?
  // Profile contact details, filled in from /account/profile. Both optional so
  // every pre-existing customer stays valid.
  phone        String?
  contactEmail String?
  avatarUrl    String?
  provider     AuthProvider
  createdAt    DateTime          @default(now())
  orders       Order[]
  reviews      ProductReview[]
  wishlist     WishlistItem[]
  cart         CustomerCart?
  cartEvents   CartEvent[]
  addresses    CustomerAddress[]
}

// A customer's saved delivery address. Capped at MAX_ADDRESSES (3) per
// customer — enforced in server/customers/addresses.ts, since a row count
// limit can't be expressed in the schema.
//
// Holds the FULL recipient (name + phone), not just the street text, so
// picking one at checkout fills every field an Order needs and a customer can
// ship to someone else without editing their profile.
model CustomerAddress {
  id             Int           @id @default(autoincrement())
  customerId     String
  // Short user-chosen name for the address picker: "Home", "Office", …
  label          String
  fullName       String
  phone          String
  address        String        @db.Text
  // Optional: the zone list is admin-managed and can change, so a saved
  // address keeps working even if its zone is later deleted.
  shippingZoneId Int?
  // Exactly one default per customer — maintained transactionally on write.
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingZone   ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

// Single-use magic-link tokens. usedAt marks consumption (kept for audit
// rather than deleted); expiresAt enforces a short window (e.g. 15 min).
model LoginToken {
  id        Int       @id @default(autoincrement())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id                 Int               @id @default(autoincrement())
  // Public, short, human-readable identifier for COD phone calls / tracking.
  orderNo            String            @unique
  // Nullable — checkout stays guest-friendly; set when the customer was
  // signed in at checkout time, purely to power order history.
  customerId         String?
  customerName       String
  customerPhone      String
  // Optional — phone is the primary contact for COD; email is only used to
  // send an order-confirmation mail when the customer provides one.
  customerEmail      String?
  address            String            @db.Text
  // Optional free-text note from the customer at checkout ("leave at gate",
  // delivery timing, etc.). Distinct from the admin-only `notes` relation.
  customerNote       String?           @db.Text
  shippingZoneId     Int?
  deliveryCharge     Int               @default(0)
  subtotal           Int
  total              Int
  // ── Financial tracking (paisa) — the real costs behind an order, entered by
  // the admin on the order detail page and aggregated by the monthly P&L. These
  // are the shop's OWN costs, distinct from deliveryCharge (what the CUSTOMER
  // pays). Defaults keep historical orders valid; admins fill them in per order.
  //
  //   shippingCost        — outbound courier fee the shop pays to deliver.
  //   returnShippingCost  — courier fee lost when an order comes back.
  //   paymentGatewayFee   — COD collection / mobile-wallet processing fee.
  //   returnRestockable   — for RETURNED orders: true = goods can be resold
  //                         (no cost impact), false = damaged (cost → Inventory
  //                         Loss under OpEx).
  shippingCost       Int               @default(0)
  returnShippingCost Int               @default(0)
  paymentGatewayFee  Int               @default(0)
  returnRestockable  Boolean           @default(true)
  // ── Stock release (Step 0) ── when this order's reserved units were put back
  // on the shelf. Set the first time the order reaches a stock-releasing state
  // (any CANCELLED, or RETURNED while returnRestockable). Acts as the
  // idempotency guard: restocking is attempted inside the status transaction
  // only while this is null, so a re-entered transition, a retried job, or a
  // bulk action replay can never double-credit stock. Null = units never
  // returned (still held by a live order, or written off as damaged).
  restockedAt        DateTime?
  // ── Reservation lifecycle (Phase D) ── when this order's reservation was
  // CONSUMED: the units left the shelf for good because the parcel shipped.
  // Until then the units are reserved but still on hand, so a cancel simply
  // frees them rather than returning them.
  //
  // Together with restockedAt this makes the reservation state machine explicit
  // and idempotent — an order's units can be released (restockedAt) or shipped
  // out (fulfilledAt), never both, and never twice. Null = the reservation is
  // still open, or was released without ever shipping.
  fulfilledAt        DateTime?
  // ── Payment (Phase 1) ──
  //   COD     — full cash on delivery (default, unchanged behaviour).
  //   ONLINE  — full amount paid through a gateway before confirmation.
  //   PARTIAL — delivery charge paid online, remainder COD (the standard BD
  //             anti-fake-order pattern).
  // paidAmount is the paisa actually CONFIRMED online (via IPN + validation),
  // so COD due on delivery = total - paidAmount.
  paymentMethod      PaymentMethod     @default(COD)
  paidAmount         Int               @default(0)
  // ── Coupon (Phase 4) ── snapshotted at checkout so later coupon edits never
  // rewrite a historical order. total already has couponDiscount subtracted.
  couponCode         String?
  couponDiscount     Int               @default(0)
  // ── Facebook attribution (Conversions API) ── click identifiers captured at
  // checkout so a later server-side Purchase event (fired when the owner phone-
  // confirms the order) can be matched back to the ad that drove it. Null when
  // the shopper didn't arrive from a Facebook ad or blocked the pixel cookie.
  //   fbp — the _fbp browser cookie the Pixel sets on every visitor.
  //   fbc — derived from the fbclid URL param on an ad click (fb.1.<ts>.<id>).
  fbp                String?
  fbc                String?
  // ── Marketing attribution (GAP 3) ── first-touch UTM params captured at
  // checkout from a landing cookie, so a delivered order can be classified to a
  // channel for ROAS/CAC even when it carries no Facebook click id (Google,
  // TikTok, etc.). Null for organic/direct visitors.
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  status             OrderStatus       @default(PENDING)
  // ── Courier (Phase 3+) ── which provider shipped this order. Set at
  // consignment-creation time and FROZEN thereafter: manual "Refresh Status"
  // and webhook routing always dispatch to THIS provider, never the currently
  // active one — so switching the shop's active courier never misroutes an
  // already-shipped order's status lookups. Null until a consignment exists.
  courierProvider    CourierProvider?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  customer           Customer?         @relation(fields: [customerId], references: [id])
  shippingZone       ShippingZone?     @relation(fields: [shippingZoneId], references: [id])
  items              OrderItem[]
  courierShipment    CourierShipment?
  statusLogs         OrderStatusLog[]
  notes              OrderNote[]
  payments           Payment[]
  returnRequests     ReturnRequest[]
  couponRedemption   CouponRedemption?
  stockMovements     StockMovement[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([customerId])
}

// Courier providers the adapter layer can dispatch to. Stored on Order once a
// consignment is created so status refresh/webhooks route to the right adapter
// regardless of which provider is currently "active" in settings.
enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
}

enum OrderStatus {
  // Online-payment orders start here: stock is already reserved (decremented)
  // but the order is not real until the gateway confirms. Auto-cancelled with
  // stock released if payment doesn't arrive within the expiry window.
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  ONLINE
  PARTIAL
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

// One gateway payment attempt. An order can have several (abandoned attempt,
// then a successful retry), so payments are rows, not columns on Order.
// amount is paisa like all money. rawPayload keeps the provider's verbatim
// IPN/validation response for dispute evidence — never parsed after write.
model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  provider      String // "sslcommerz" | "bkash" | "mock"
  amount        Int
  status        PaymentStatus @default(INITIATED)
  // Provider's transaction/reference id once known (val_id / trxID). The
  // provider's idempotency anchor for IPN retries.
  providerTxnId String?
  rawPayload    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([provider, providerTxnId])
}

model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      Int
  productId    Int?
  // Which size/option was bought, if the product is sized. variantLabel is a
  // SNAPSHOT (like productName) so historical orders survive a variant edit.
  variantId    Int?
  variantLabel String?
  // SNAPSHOTS — frozen at purchase time. Editing or deleting a product later
  // must never change historical orders, so name + price live on the row.
  productName  String
  unitPrice    Int
  // SNAPSHOT of the sourcing cost per unit (paisa) at purchase time — the COGS
  // basis for this line. Frozen here so a later supplier-price edit on the
  // product never distorts a past month's profit. See createOrder.ts.
  purchaseCost Int             @default(0)
  quantity     Int
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Append-only audit trail of every status transition. fromStatus is null for
// the very first (PENDING) entry written at order creation. changedBy holds
// the admin username, or null for system/customer-originated changes.
model OrderStatusLog {
  id         Int          @id @default(autoincrement())
  orderId    Int
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?
  note       String?      @db.Text
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// Internal staff notes on an order (e.g. "called customer, confirmed address").
// Never shown to customers; author is the admin username.
model OrderNote {
  id        Int      @id @default(autoincrement())
  orderId   Int
  body      String   @db.Text
  author    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Settings & shipping
// ─────────────────────────────────────────────────────────────

model ShippingZone {
  id        Int               @id @default(autoincrement())
  name      String
  charge    Int               @default(0)
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  orders    Order[]
  addresses CustomerAddress[]

  @@index([isActive, sortOrder])
}

model AdminUser {
  id               Int                  @id @default(autoincrement())
  username         String               @unique
  // Recovery address for password resets. Nullable so pre-existing admins stay
  // valid; a reset can only be requested for an admin that has one set.
  email            String?              @unique
  passwordHash     String
  // RBAC (Phase 3). See lib/permissions.ts for what each role may do. The
  // permission check re-reads role + isActive from this row on every request,
  // so a role change or deactivation takes effect immediately (not on next login).
  role             AdminRole            @default(STAFF)
  // Deactivated admins keep their row (for audit-log attribution) but can't
  // log in or hold a valid session.
  isActive         Boolean              @default(true)
  // Optional TOTP two-factor. Secret is encrypted at rest via lib/crypto.
  twoFactorSecret  String?
  twoFactorEnabled Boolean              @default(false)
  createdAt        DateTime             @default(now())
  resetTokens      PasswordResetToken[]
  activityLogs     AdminActivityLog[]
  backupCodes      AdminBackupCode[]
}

// One-time 2FA recovery codes, for when an admin can't reach their
// authenticator app. Generated 10 at a time (see server/admin/twofactor.ts);
// regenerating deletes the old set so a leaked/lost batch can't be reused.
// Only the bcrypt hash is stored — like passwordHash, the plaintext is shown
// to the admin once at generation time and never persisted.
model AdminBackupCode {
  id        Int       @id @default(autoincrement())
  adminId   Int
  codeHash  String
  // AES-GCM encrypted code value (lib/crypto), so the admin panel can show the
  // plaintext of used codes. Nullable: codes generated before this column
  // existed have only the one-way hash and can't be displayed. Verification
  // always uses codeHash — codeEnc is display-only.
  codeEnc   String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

// Append-only audit trail of privileged admin actions — same pattern as
// OrderStatusLog/OrderNote. actorName is a SNAPSHOT of the username so the
// log survives an admin rename or deletion. adminId is nullable for
// system-originated entries.
model AdminActivityLog {
  id        Int        @id @default(autoincrement())
  adminId   Int?
  actorName String
  action    String
  detail    String?    @db.Text
  createdAt DateTime   @default(now())
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId])
}

// Single-use, short-lived admin password-reset tokens. usedAt marks
// consumption (kept for audit rather than deleted, like LoginToken) so a
// replayed link is rejected even inside the expiry window.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  adminId   Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// The DB row is the editable source of truth; middleware enforces against a
// mirrored Redis SET (O(1), no DB hit per request). On add/remove, sync both,
// and rebuild the Redis set from this table on boot so a cache flush can't
// silently unblock everyone.
model BlockedIp {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Audit log for every outbound mail attempt — sent via the queue, never
// inline with checkout. One row per attempt (including retries), so a
// failure trail is visible even though the worker retries automatically.
model MailLog {
  id        Int          @id @default(autoincrement())
  to        String
  subject   String
  template  String
  status    NotifyStatus @default(PENDING)
  error     String?      @db.Text
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

// Same auditing role as MailLog, for SMS sends.
model SmsLog {
  id        Int          @id @default(autoincrement())
  to        String
  template  String
  status    NotifyStatus @default(PENDING)
  error     String?      @db.Text
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

enum NotifyStatus {
  PENDING
  SENT
  FAILED
}

// One consignment per order. Webhook updates key on consignmentId + status
// so a duplicate callback (providers retry) is a no-op rather than a
// double-write — see the webhook route for the idempotency check.
model CourierShipment {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  courierName   String
  consignmentId String   @unique
  trackingCode  String?
  courierStatus String
  // True when this consignment was created by the Steadfast SIMULATOR (test
  // mode) and never reached a real courier. Frozen at creation like
  // Order.courierProvider: refresh/webhooks must follow the mode the shipment
  // was made in, never the current setting, so flipping to live can't send a
  // fake consignment id to the real API.
  isTest        Boolean  @default(false)
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([consignmentId])
}

// Cached per phone number — also mirrored in Redis (see lib/fraud-cache.ts)
// since fraud lookups cost money/time per call.
model FraudCheckResult {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  totalOrders   Int      @default(0)
  successOrders Int      @default(0)
  returnOrders  Int      @default(0)
  riskScore     Int
  checkedAt     DateTime @default(now())
}

// Generic encrypted-capable config store. `group` namespaces keys
// (e.g. "smtp", "courier"); secrets are encrypted at rest via lib/crypto.ts
// and flagged with isEncrypted so the reader knows to decrypt.
model Setting {
  id          Int      @id @default(autoincrement())
  group       String
  key         String
  value       String   @db.Text
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([group, key])
}

enum PageStatus {
  PUBLISHED
  DRAFT
}

// Fixed set of footer/legal/support pages (About Us, Contact Us, Company
// Information, Terms & Conditions, Privacy Policy, Support Center, How to
// Order, Order Tracking, Payment, Shipping). Slugs are seeded once and never
// created/deleted from the admin UI — admins only edit title/content/status.
model Page {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  title           String
  content         String     @db.Text
  status          PageStatus @default(PUBLISHED)
  // Optional SEO overrides (Phase 2); blank → default from title/content.
  metaTitle       String?
  metaDescription String?    @db.Text
  updatedAt       DateTime   @updatedAt
}

// FAQ entries shown on the FAQ page. Unlike Page, this is a real list the
// admin can add/remove/reorder, since FAQs are naturally many Q&A pairs
// rather than one block of content.
model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Finance — manual operating expenses (OpEx)
// ─────────────────────────────────────────────────────────────

// Fixed / recurring overheads the admin enters by hand — marketing spend,
// hosting, rent, salaries, etc. These are the OpEx items that don't fall out of
// order data automatically. `incurredOn` (not createdAt) drives which month the
// expense lands in on the P&L, so a bill can be back-dated to the month it
// belongs to. `amount` is paisa, like every other money field.
model Expense {
  id          Int             @id @default(autoincrement())
  category    ExpenseCategory @default(OTHER)
  description String
  amount      Int
  incurredOn  DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([incurredOn])
}

enum ExpenseCategory {
  MARKETING // ads, promotions, influencer spend
  SOFTWARE // hosting, SaaS tools, domains
  RENT // office / warehouse rent
  SALARY // staff wages
  UTILITIES // internet, electricity, phone
  PACKAGING // boxes, tape, polymailers
  OTHER
}

// Ad spend by channel, entered by hand (no ad-platform APIs in v1). Kept SEPARATE
// from Expense: the finance dashboard ties this against ATTRIBUTED delivered-order
// revenue to compute per-channel ROAS and CAC, which needs a channel dimension the
// generic Expense.MARKETING line doesn't carry. `spentOn` (not createdAt) decides
// which month a spend lands in — same back-dating convention as Expense.incurredOn.
// `amount` is paisa, like every money field. Overlaps with the MARKETING expense
// line by design (spend is tracked here for ROAS; whether it also books to the P&L
// as a MARKETING expense is a separate manual entry).
model AdSpend {
  id        Int       @id @default(autoincrement())
  channel   AdChannel @default(FACEBOOK)
  amount    Int // paisa
  spentOn   DateTime // any day in the month the spend belongs to
  note      String?
  createdBy String? // admin username who entered it (audit)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spentOn])
  @@index([channel, spentOn])
}

// Marketing channels an order can be attributed to, and that spend is booked
// against. ORGANIC/DIRECT is the catch-all for orders with no ad attribution;
// no spend is entered against it, so its ROAS/CAC are not shown.
enum AdChannel {
  FACEBOOK
  GOOGLE
  TIKTOK
  OTHER
}

// Lightweight storefront funnel events, recorded server-side where each action
// already happens (product view, add-to-cart, checkout start, order placed), so
// the admin can see conversion rates in-house instead of only firing pixel
// events outward. Writes are fire-and-forget — never block or fail the
// user-facing action — and blocked-IP / bot traffic is filtered before insert.
//
// sessionId = the anonymous/identified customer id (no new cookie is minted);
// it's coarse by design and used mainly for the per-session/product/day view
// debounce. Rows older than 90 days are pruned by the daily maintenance job.
model FunnelEvent {
  id        Int             @id @default(autoincrement())
  type      FunnelEventType
  sessionId String
  productId Int?
  createdAt DateTime        @default(now())

  // Range scans by (type, createdAt) drive the 30-day funnel aggregation and
  // the 90-day prune; no FK on productId — events must survive product deletes.
  @@index([type, createdAt])
  @@index([createdAt])
}

enum FunnelEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  ORDER_PLACED
}

// ─────────────────────────────────────────────────────────────
// Phase 4 — Conversion & Anti-Fraud
// ─────────────────────────────────────────────────────────────

// Discount code. `value` is a whole-number percentage for PERCENT, or a paisa
// amount for FIXED. maxDiscount caps a percent coupon. The discount is
// SNAPSHOTTED onto the Order at checkout, so later edits never rewrite history.
model Coupon {
  id               Int                @id @default(autoincrement())
  code             String             @unique
  type             CouponType
  value            Int
  minOrder         Int                @default(0) // paisa; 0 = no minimum
  maxDiscount      Int? // paisa cap for percent coupons
  usageLimit       Int? // total redemptions across all customers (null = unlimited)
  perCustomerLimit Int? // redemptions per customer (null = unlimited)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean            @default(true)
  timesUsed        Int                @default(0)
  // Scope: what the discount applies to. ALL = whole cart (default).
  // CATEGORY = only lines whose product is in categoryId. PRODUCT = only
  // lines for productId. For CATEGORY/PRODUCT the percent/fixed discount is
  // computed against the ELIGIBLE lines' subtotal, not the whole cart.
  appliesTo        CouponScope        @default(ALL)
  categoryId       Int?
  productId        Int?
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product          Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redemptions      CouponRedemption[]

  @@index([isActive])
  @@index([categoryId])
  @@index([productId])
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
}

// One row per successful coupon use. Enforces per-customer limits (by phone,
// which every order has) and drives the "times used" counter.
model CouponRedemption {
  id            Int      @id @default(autoincrement())
  couponId      Int
  orderId       Int      @unique
  customerId    String?
  customerPhone String
  amount        Int // paisa discount applied
  createdAt     DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerPhone])
}

// A saved cart for an identified customer, used for abandoned-cart recovery.
// One live cart per customerId (upserted). recoveryToken powers the restore
// link; reminderSentAt/recoveredAt drive the delayed job and the report.
model CartSession {
  id             Int       @id @default(autoincrement())
  customerId     String?   @unique
  email          String?
  phone          String?
  items          Json // snapshot of cart lines (productId, variantId, qty, name, price)
  subtotal       Int
  recoveryToken  String    @unique
  reminderSentAt DateTime?
  recoveredAt    DateTime?
  orderedAt      DateTime? // set when this cart's customer places an order (no reminder needed)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([reminderSentAt, orderedAt, updatedAt])
}

// Customer-initiated return request against a delivered order. Feeds an admin
// queue; approving it drives the existing RETURNED order workflow.
model ReturnRequest {
  id         Int          @id @default(autoincrement())
  orderId    Int
  customerId String?
  reason     String       @db.Text
  photoUrl   String?
  status     ReturnStatus @default(PENDING)
  adminNote  String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orderId])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

// A product a customer saved to their wishlist. One row per (customer, product).
model WishlistItem {
  id         Int      @id @default(autoincrement())
  customerId String
  productId  Int
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
}

// The logged-in customer's live cart, persisted server-side so it follows them
// across devices. One cart per customer. Like the client-side store in
// lib/cart-store.ts this is DISPLAY ONLY — checkout re-verifies price and stock
// inside a transaction; the browser (and this table) are never trusted for what
// gets charged. Guests keep a localStorage-only cart and have no row here.
model CustomerCart {
  id         Int                @id @default(autoincrement())
  customerId String             @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CustomerCartItem[]
}

// One line of a persisted cart, identified by (cart, product, variant) — the
// same product in two variants is two lines, mirroring cartLineKey() in
// lib/cart-store.ts. variantId is a plain nullable column (as in WishlistItem /
// StockNotification), null when the product has no variants.
model CustomerCartItem {
  id        Int          @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  cart      CustomerCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// Append-only log of add-to-cart events for the profile's cart-history tab.
// Distinct from CustomerCart (the live cart): this records every add, even for
// items later removed, so the history is a faithful trail. Written only for
// logged-in customers.
model CartEvent {
  id         Int      @id @default(autoincrement())
  customerId String
  productId  Int
  variantId  Int?
  quantity   Int
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([productId])
}

// "Notify me when back in stock" subscription. notifiedAt is set once the
// alert has been queued, so a later restock doesn't re-notify the same person.
model StockNotification {
  id         Int       @id @default(autoincrement())
  productId  Int
  variantId  Int?
  email      String?
  phone      String?
  customerId String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, notifiedAt])
}

// DEPRECATED (Phase A) — superseded by StockMovement, which records EVERY stock
// change rather than only hand corrections. Rows were copied across by
// migration 20260816120000_add_stock_movement_ledger; nothing writes here any
// more. Kept read-only as a safety net so the copy can be verified against the
// original before the table is finally dropped.
model StockAdjustment {
  id        Int      @id @default(autoincrement())
  productId Int
  variantId Int?
  delta     Int
  newStock  Int
  reason    String
  adminName String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Purchasing (Phase E)
// ─────────────────────────────────────────────────────────────

// Someone you buy stock from. Deliberately thin — a name and how to reach them
// — because the point of this model is attribution ("who supplies this?") and a
// lead time, not a CRM.
model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  phone          String?
  email          String?
  address        String?         @db.Text
  note           String?         @db.Text
  // Typical days from placing an order to receiving it. Feeds the reorder-point
  // calculation, which until now used one global default for every product.
  // Null = fall back to that global default.
  leadTimeDays   Int?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([isActive, name])
}

// Lifecycle of a purchase order.
//
//   DRAFT     being written; counts toward nothing
//   ORDERED   placed with the supplier — its outstanding units are INCOMING
//   RECEIVED  fully received; every line delivered
//   CANCELLED abandoned; incoming units drop away
//
// PARTIAL is deliberately absent: "partially received" is derived from the
// lines (some receivedQty > 0, but not all complete), so it can never disagree
// with them the way a stored status could.
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

// An order placed WITH a supplier — the mirror of a customer Order. Its open
// lines are what "Incoming" means on the stock overview.
//
// Receiving a line writes a PURCHASE movement through the same ledger as every
// other stock change, so incoming goods are not a special case: they arrive,
// stock rises, and the ledger says why.
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  // Short human reference for talking to the supplier ("PO-0042").
  poNo         String              @unique
  supplierId   Int
  status       PurchaseOrderStatus @default(DRAFT)
  // When the goods are expected. The single most useful field on this model:
  // it turns "we ordered more" into "cover until the 20th".
  expectedOn   DateTime?
  // Costs that apply to the SHIPMENT rather than to any one line (freight,
  // customs, clearing). Apportioned across lines by value when receiving, so
  // landed cost reflects what the goods really cost to get here.
  shippingCost Int                 @default(0)
  customsCost  Int                 @default(0)
  note         String?             @db.Text
  // Set once the PO reaches a terminal state, for lead-time reporting.
  orderedAt    DateTime?
  receivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]

  @@index([status, expectedOn])
  @@index([supplierId])
}

// One product (or variant) on a purchase order.
//
// receivedQty tracks partial deliveries: a supplier who ships 60 of 100 leaves
// 40 still incoming, and the line stays open until they arrive or the PO is
// closed. Receiving is additive and idempotent per receipt, never a toggle.
model PurchaseOrderLine {
  id              Int             @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  // The exact option ordered, when the product is sized. SetNull because
  // variants are wiped and recreated on every product save.
  variantId       Int?
  // SNAPSHOT of what this product was called when the PO was written, so a
  // later rename doesn't rewrite the paperwork you sent the supplier.
  productName     String
  variantLabel    String?
  quantity        Int
  // Received so far. 0 ≤ receivedQty ≤ quantity; the difference is INCOMING.
  receivedQty     Int             @default(0)
  // Agreed per-unit price from the supplier, in paisa. This is the invoice
  // price — freight and customs are added at receipt to give landed cost.
  unitCost        Int
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
}

// Why a stock level changed. The ledger is append-only, so these are facts
// about the past — never re-interpret an existing row's type.
//
//   SALE            an order SHIPPED, so the units left the shelf (negative).
//                   Since Phase D this is fulfilment, not checkout — an order
//                   that never ships only ever held a reservation.
//   CANCEL_RESTOCK  a dead order gave its units back (positive)
//   RETURN          delivered goods came back resellable (positive)
//   DAMAGE          units written off — breakage, or a return too damaged to
//                   resell (negative). Distinct from ADJUSTMENT because it is a
//                   real loss with a cost, not a counting correction.
//   PURCHASE        stock received from a supplier (positive)
//   ADJUSTMENT      a stock-take correction — the count was simply wrong
//                   (either sign). Carries no cost implication of its own.
enum StockMovementType {
  SALE
  CANCEL_RESTOCK
  RETURN
  DAMAGE
  PURCHASE
  ADJUSTMENT
}

// THE inventory ledger: one row for every change to a stock level, from any
// source. Append-only — rows are never updated or deleted, so the history of a
// SKU can always be replayed.
//
// Product.stock / ProductVariant.stock remain the fast path the storefront and
// checkout read, but they are a CACHE of this ledger's sum. When the two
// disagree the ledger is right and the cache has drifted (see
// scripts/stock-ledger-verify.ts).
//
// Every write must happen inside the same transaction as the stock update it
// describes, so a movement can never be orphaned from its effect, nor an effect
// go unrecorded.
model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int
  // Which stock row actually moved: the variant's when set, else the product's.
  // Mirrors how checkout decrements — a sized product holds stock per variant.
  variantId Int?
  type      StockMovementType
  // Signed change (+ added, − removed). Never zero.
  delta     Int
  // The level before and after this movement, on the row identified above.
  // Stored rather than derived so a replay can pinpoint exactly where a
  // discrepancy entered, instead of only showing that one exists.
  beforeQty Int
  afterQty  Int
  // Per-unit sourcing cost in paisa at the time of the movement, SNAPSHOTTED
  // like OrderItem.purchaseCost — inventory valuation and write-off cost must
  // use the cost that applied then, not today's supplier price. Null when not
  // meaningful (a stock-take correction has no cost basis).
  unitCost  Int?
  // The order that caused this, for SALE / CANCEL_RESTOCK / RETURN. Null for
  // PURCHASE / DAMAGE / ADJUSTMENT. SetNull rather than Cascade: deleting an
  // order must never erase the fact that stock moved.
  orderId   Int?
  // Free text for the movements a human initiates (ADJUSTMENT, DAMAGE,
  // PURCHASE). Null for system-generated rows, which explain themselves via
  // type + orderId.
  //
  // A PURCHASE receipt puts its PO number here ("PO-0042") rather than carrying
  // a third nullable FK: the ledger is the hottest table in the inventory
  // system, and the reference is for a human reading a row, not for joining.
  reason    String?
  // Who caused it: an admin username, "customer" for self-service, or "system"
  // for job- and webhook-driven changes.
  actorName String
  createdAt DateTime          @default(now())
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // The ledger view for one product, newest first.
  @@index([productId, createdAt])
  // Per-variant history, and the replay in stock-ledger-verify.
  @@index([variantId, createdAt])
  // "What did this order do to stock?" on the order detail page.
  @@index([orderId])
  // Velocity and dead-stock reports scan by type over a date range.
  @@index([type, createdAt])
}

// Newsletter signups from the storefront footer box ("Get ৳150 off…"). Email is
// unique so a re-subscribe is a no-op (see server/newsletter). name is captured
// from the logged-in customer at signup time when available, else left blank.
// customerId is a soft link (the customer id string) for later attribution.
model NewsletterSubscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String?
  customerId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
